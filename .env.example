# Anthropic API key for Claude 3.5 Sonnet (image analysis).
# Get it from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Database. For local dev with SQLite:
DATABASE_URL="file:./dev.db"

# Turso (optional). When set, the app uses Turso instead of local SQLite.
# Create DB: https://turso.tech → get URL and auth token.
# TURSO_DATABASE_URL="libsql://your-db-name-your-org.turso.io"
# TURSO_AUTH_TOKEN=

# Cloudinary (optional). When set, analyzed images are uploaded to Cloudinary.
# Get credentials from: https://cloudinary.com/console
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Server port (default 3000)
PORT=3000
