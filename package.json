{
  "name": "backend-trashclient",
  "version": "1.0.0",
  "description": "API for trash detection (Claude 3.5 Sonnet) and geographic storage for collection optimization",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "cross-env DATABASE_URL=file:./test.db npx prisma migrate deploy && vitest run",
    "test:watch": "cross-env DATABASE_URL=file:./test.db vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@libsql/client": "^0.8.1",
    "@prisma/adapter-libsql": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "ngeohash": "^0.6.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/ngeohash": "^0.6.4",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "cross-env": "^7.0.3",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
