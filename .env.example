# Anthropic API key para Claude 3.5 Sonnet (análisis de imágenes).
# OPCIONAL para hackatón: si la dejas vacía o en "demo", la API usa análisis DEMO
# heurístico (source "demo") y puedes probar mapa/trace/WEAP sin licencia.
# Para producción pon tu key real: https://console.anthropic.com/
ANTHROPIC_API_KEY=demo

# Database – required by Prisma CLI (generate, migrate). Use file: for SQLite.
# When you use Turso (see below), keep this as file:./dev.db so Prisma commands work.
# The app will connect to Turso at runtime when TURSO_* are set; it does not use this URL then.
DATABASE_URL="file:./dev.db"

# Turso – when set, the app uses Turso at runtime instead of DATABASE_URL.
# Create DB: https://turso.tech → get URL and auth token.
# Keep DATABASE_URL="file:./dev.db" above so Prisma CLI (generate, migrate) works.
# TURSO_DATABASE_URL="libsql://your-db-name-your-org.turso.io"
# TURSO_AUTH_TOKEN=

# Cloudinary (optional). When set, analyzed images are uploaded to Cloudinary.
# Get credentials from: https://cloudinary.com/console
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Server port (default 3000)
PORT=3000

# Frontend URL(s) for CORS (comma separated). Vite default:
FRONTEND_URL=http://localhost:5173
