# Anthropic API key for Claude 3.5 Sonnet (image analysis).
# Get it from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Database. For local dev with SQLite:
DATABASE_URL="file:./dev.db"

# Turso (optional). When set, the app uses Turso instead of local SQLite.
# Create DB: https://turso.tech → get URL and auth token.
# TURSO_DATABASE_URL="libsql://your-db-name-your-org.turso.io"
# TURSO_AUTH_TOKEN=

# Google Cloud Storage (optional). When set, analyzed images are uploaded to GCS.
# Create a bucket and use Application Default Credentials or a service account key.
# GCS_BUCKET=
# GCLOUD_PROJECT_ID=

# Server port (default 3000)
PORT=3000
