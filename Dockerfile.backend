# HydroTrash backend — build autocontenido (no copia node_modules de Windows).
# Por qué: node_modules de Windows NO sirve en Linux (binarios nativos libsql/prisma
# compilados para win32 no cargan en glibc/musl), y el contexto de 64kB confirma
# que ni siquiera llega al daemon. Este Dockerfile instala en Linux con reintentos.
# Si la red bloquea npm (ETIMEDOUT/x509), usa el MODO HÍBRIDO (ver docker-up.sh):
# frontend en Docker + backend local con `npm start`.
FROM node:20-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json* ./
COPY prisma ./prisma
RUN npm config set fetch-retries 5 \
 && npm config set fetch-retry-mintimeout 20000 \
 && npm config set fetch-retry-maxtimeout 120000 \
 && (npm ci --omit=dev || npm install --omit=dev) \
 && npm cache clean --force
# dist/ compilado en local (tsc es portable, sin binarios nativos)
COPY dist ./dist
RUN mkdir -p /data
EXPOSE 3000
CMD ["sh", "-c", "DATABASE_URL=file:/data/prod.db npx prisma migrate deploy && DATABASE_URL=file:/data/prod.db node dist/index.js"]
